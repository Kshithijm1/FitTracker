NODE_ENV=development
PORT=3000

# Neon/Postgres connection string
DATABASE_URL=postgres://user:password@localhost:5432/fittrack

# openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-random-32+-byte-hex-string
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Sign in with Apple
APPLE_BUNDLE_ID=com.fittrack.app
APPLE_TEAM_ID=

# Freeform meal AI estimate (server-side only, never shipped to the client).
# Uses claude-haiku-4-5 — ~$1/$5 per MTok in/out; a single meal estimate is a
# few hundred input tokens + a small JSON reply, so budget well under $0.001/call.
# Without this set, POST /v1/nutrition/estimate returns 503 (client falls back to manual entry).
ANTHROPIC_API_KEY=
