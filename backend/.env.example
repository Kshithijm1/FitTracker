NODE_ENV=development
PORT=3000

# Neon/Postgres connection string
DATABASE_URL=postgres://user:password@localhost:5432/fittrack

# openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-random-32+-byte-hex-string
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Sign in with Apple
APPLE_BUNDLE_ID=com.kshithijm.fittrack
APPLE_TEAM_ID=

# AI features (coach chat, food/equipment photo, recipe import, freeform meal
# estimate) — server-side only, never shipped to the client. Uses Gemini's
# free tier (gemini-2.5-flash) — get a key at https://aistudio.google.com/apikey.
# Without this set, AI routes return 503 (clients fall back to manual entry).
GEMINI_API_KEY=
